{
  "manifest_version": 3,
  "name": "AIDos Immersive Translator",
  "version": "1.0.0",
  "description": "Translate English, Japanese, Korean, Spanish, Italian, and Arabic webpages into Traditional Chinese.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AIDos Translate",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
